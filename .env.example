# LLM Provider Configuration
# Choose one or configure multiple

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM provider (anthropic or openai)
DEFAULT_LLM_PROVIDER=anthropic

# Search API Configuration
# Examples: SerpAPI, ScaleSerp, Google Custom Search, etc.
SEARCH_API_KEY=your_search_api_key_here
SEARCH_API_PROVIDER=serpapi

# Application Settings
LOG_LEVEL=INFO
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Database (optional - defaults to .osint85/project.db)
# DATABASE_PATH=.osint85/project.db

# Rate Limiting
SEARCH_RATE_LIMIT=10  # requests per minute
LLM_RATE_LIMIT=50     # requests per minute
