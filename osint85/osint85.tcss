/* OSINT-85 Command Nexus - Tactical HUD Styling */

/* Global Screen */
Screen {
    background: #0d0f12;
    color: #00d4ff;
}

/* Header */
Header {
    background: #0a0c0f;
    color: #00d4ff;
    text-style: bold;
}

/* Footer */
Footer {
    background: #0a0c0f;
    color: #00d4ff;
}

/* Main Layout */
#main-layout {
    height: 1fr;
}

/* Sidebar */
#sidebar {
    width: 30%;
    border: tall #1b1e24;
    background: #0f1115;
    padding: 1 2;
}

.sidebar-title {
    text-style: bold;
    color: #00d4ff;
    background: #1b1e24;
    padding: 1;
    margin-bottom: 1;
}

CategoryItem {
    height: 3;
    padding: 1 2;
    margin: 0 0 1 0;
    background: #14161a;
    border: tall #1b1e24;
}

CategoryItem:hover {
    background: #1a1d22;
    border: tall #00d4ff;
}

CategoryItem.selected {
    background: #1a2830;
    border: tall #00d4ff;
    text-style: bold;
}

/* Content Stack */
#content-stack {
    width: 70%;
}

/* Query Builder Panel */
#query-builder {
    height: 40%;
    border: tall #1b1e24;
    background: #0f1115;
    padding: 1 2;
}

.panel-title {
    text-style: bold;
    color: #00d4ff;
    background: #1b1e24;
    padding: 1;
    margin-bottom: 1;
}

#qb-desc {
    color: #ffffff;
    margin-bottom: 1;
}

#query-list {
    height: auto;
    max-height: 15;
    overflow-y: auto;
    margin-bottom: 1;
}

#query-list > Label {
    padding: 1;
    margin: 0 0 1 0;
    background: #14161a;
}

/* Buttons */
.button-row {
    height: auto;
    align: center middle;
}

Button {
    margin: 0 1;
}

Button:hover {
    text-style: bold;
}

/* Result Grid */
#results {
    height: 60%;
    border: tall #1b1e24;
    background: #0f1115;
}

DataTable {
    background: #0f1115;
    color: #00d4ff;
}

DataTable > .datatable--header {
    background: #1b1e24;
    color: #00d4ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1a2830;
    color: #ffffff;
}

DataTable:focus > .datatable--cursor {
    background: #205070;
}

/* Event Log */
#event-log {
    height: 10;
    background: #0a0c0f;
    border-top: tall #1b1e24;
    padding: 1 2;
}

Log {
    background: #0a0c0f;
    color: #00d4ff;
}

/* Modal Containers */
#project-modal, #generate-modal, #scan-modal {
    align: center middle;
    width: 60;
    height: auto;
    max-height: 30;
    background: #0f1115;
    border: thick #00d4ff;
    padding: 2;
}

.modal-title {
    text-style: bold;
    color: #00d4ff;
    background: #1b1e24;
    padding: 1;
    margin-bottom: 1;
    width: 100%;
    text-align: center;
}

#project-list {
    height: 15;
    border: tall #1b1e24;
    background: #14161a;
    margin-bottom: 1;
}

ListView {
    background: #14161a;
    border: tall #1b1e24;
}

ListItem {
    padding: 1;
}

ListItem:hover {
    background: #1a1d22;
}

ListItem.--highlight {
    background: #1a2830;
}

/* Input Fields */
Input {
    background: #14161a;
    border: tall #1b1e24;
    color: #ffffff;
    margin-bottom: 1;
}

Input:focus {
    border: tall #00d4ff;
}

/* Progress Bar */
ProgressBar {
    background: #14161a;
    color: #00d4ff;
    margin-bottom: 1;
}

/* Status Container */
#generation-status, #scan-status {
    margin-top: 1;
    padding: 1;
    background: #14161a;
}

/* Scrollbars */
::-webkit-scrollbar {
    width: 1;
}

::-webkit-scrollbar-thumb {
    background: #00d4ff;
}

::-webkit-scrollbar-track {
    background: #1b1e24;
}

/* Animations */
CategoryItem {
    transition: background 200ms, border 200ms;
}

Button {
    transition: background 150ms;
}

/* Neon glow effect for focused elements */
*:focus {
    border: tall #00d4ff;
}

/* Terminal phosphor effect */
Label {
    text-style: none;
}

Static {
    color: #00d4ff;
}

/* High contrast text */
.error {
    color: #ff3366;
    text-style: bold;
}

.success {
    color: #00ff88;
    text-style: bold;
}

.warning {
    color: #ffaa00;
}

.info {
    color: #00d4ff;
}

/* ========================================
   COMMAND PALETTE
   ======================================== */

/* Command Palette Container */
CommandPalette {
    align: center middle;
}

#palette-container {
    width: 75;
    height: auto;
    max-height: 40;
    background: #0a0c0f;
    border: thick #00d4ff;
    border-title-color: #00d4ff;
    border-title-style: bold;
    padding: 0;
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
}

/* Palette Title */
#palette-title {
    text-style: bold;
    color: #00d4ff;
    background: #1b1e24;
    padding: 1 2;
    text-align: center;
    border-bottom: tall #00d4ff;
}

/* Palette Input */
#palette-input {
    background: #14161a;
    border: none;
    border-bottom: tall #1b1e24;
    color: #ffffff;
    padding: 1 2;
    margin: 0;
}

#palette-input:focus {
    background: #1a1d22;
    border-bottom: tall #00d4ff;
}

#palette-input > .input--placeholder {
    color: #5a6370;
    text-style: italic;
}

/* Palette Results List */
#palette-results {
    height: auto;
    max-height: 25;
    background: #0f1115;
    border: none;
    padding: 0;
    margin: 0;
}

#palette-results:focus {
    border: none;
}

/* No Results Message */
#no-results {
    padding: 4 2;
    text-align: center;
    color: #5a6370;
    text-style: italic;
}

.hidden {
    display: none;
}

/* Command Item Styling */
CommandItem {
    height: auto;
    min-height: 5;
    background: #0f1115;
    border: none;
    border-bottom: tall #1b1e24;
    padding: 0;
    margin: 0;
}

CommandItem:hover {
    background: #1a1d22;
    border-left: wide #00d4ff;
}

CommandItem.-active {
    background: #1a2830;
    border-left: wide #00d4ff;
}

.command-item-content {
    padding: 1 2;
    height: auto;
}

/* Command Item Text */
CommandItem .command-item-content {
    color: #ffffff;
}

CommandItem:hover .command-item-content {
    color: #00d4ff;
}

CommandItem.-active .command-item-content {
    color: #00d4ff;
    text-style: bold;
}

/* Palette Animation */
CommandPalette {
    transition: offset 200ms;
}

CommandItem {
    transition: background 150ms, border 150ms;
}

#palette-input {
    transition: background 150ms, border 150ms;
}

/* Palette Focus Effects */
#palette-input:focus {
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.2);
}

/* Command Category Colors */
CommandItem[data-category="project"] {
    border-left-color: #ff3366;
}

CommandItem[data-category="query"] {
    border-left-color: #ffaa00;
}

CommandItem[data-category="scan"] {
    border-left-color: #00ff88;
}

CommandItem[data-category="report"] {
    border-left-color: #00d4ff;
}

CommandItem[data-category="navigation"] {
    border-left-color: #9966ff;
}

CommandItem[data-category="view"] {
    border-left-color: #66ffff;
}

CommandItem[data-category="system"] {
    border-left-color: #ff6666;
}

/* Neon glow on hover */
CommandItem:hover {
    box-shadow: 0 0 5px rgba(0, 212, 255, 0.1);
}

CommandItem.-active {
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.2);
}

/* ============================================================
   Result Detail View
   ============================================================ */

/* Detail View Container */
#detail-container {
    width: 90;
    height: auto;
    max-height: 45;
    background: #0a0c0f;
    border: thick #00d4ff;
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
    padding: 1 2;
}

/* Detail View Title */
#detail-title {
    text-style: bold;
    color: #00d4ff;
    background: #1b1e24;
    padding: 1;
    margin-bottom: 1;
    text-align: center;
}

/* Detail Content Area */
#detail-content {
    height: 1fr;
    margin: 0 0 1 0;
    padding: 1;
    background: #0d0f12;
    border: tall #1b1e24;
}

/* Field Labels */
.field-label {
    text-style: bold;
    color: #00d4ff;
    margin-top: 1;
    margin-bottom: 0;
    padding-left: 1;
}

/* Field Values */
.field-value {
    color: #ffffff;
    background: #14161a;
    padding: 1;
    margin-bottom: 1;
    border-left: wide #1b1e24;
}

/* URL Value (special highlight) */
.url-value {
    color: #00d4ff;
    text-style: underline;
}

/* Snippet Value (wrap text) */
.snippet-value {
    color: #e0e0e0;
}

/* AI Summary (special styling) */
.ai-summary {
    color: #b8f0ff;
    background: #1a1d22;
    border-left: wide #00d4ff;
}

/* Action Buttons Container */
#detail-actions {
    height: auto;
    align: center middle;
    padding: 1 0 0 0;
}

#detail-actions Button {
    margin: 0 1;
    min-width: 20;
}

#btn-summarize {
    background: #00d4ff;
    color: #0a0c0f;
    border: none;
    text-style: bold;
}

#btn-summarize:hover {
    background: #33ddff;
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
}

#btn-export {
    background: #14161a;
    color: #00d4ff;
    border: tall #00d4ff;
    text-style: bold;
}

#btn-export:hover {
    background: #1a1d22;
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
}

#btn-close {
    background: #2a1a1a;
    color: #ff6b6b;
    border: tall #ff3366;
}

#btn-close:hover {
    background: #3a2222;
    box-shadow: 0 0 10px rgba(255, 51, 102, 0.3);
}


/* ============================================================
   Live Scan Modal
   ============================================================ */

/* Live Scan Modal Container */
#live-scan-modal {
    width: 70;
    height: auto;
    background: #0a0c0f;
    border: thick #ff3366;
    box-shadow: 0 0 25px rgba(255, 51, 102, 0.4);
    padding: 2;
}

#live-scan-modal .modal-title {
    color: #ff3366;
    text-style: bold;
    background: #1b1e24;
    padding: 1;
    margin-bottom: 1;
    text-align: center;
}

/* Live Scan Status */
#live-scan-status {
    color: #00d4ff;
    padding: 1;
    margin-bottom: 1;
    background: #0d0f12;
    border-left: wide #00d4ff;
}

#live-scan-count {
    color: #ffaa00;
    padding: 1;
    margin-bottom: 1;
    background: #0d0f12;
    border-left: wide #ffaa00;
    text-style: bold;
}

#btn-stop-scan {
    background: #3a2222;
    color: #ff6b6b;
    border: tall #ff3366;
    text-style: bold;
}

#btn-stop-scan:hover {
    background: #4a2a2a;
    box-shadow: 0 0 15px rgba(255, 51, 102, 0.5);
}

/* Result Grid Row Animation (for new rows) */
ResultGrid DataTable > .datatable--cursor {
    background: #1a2830;
}

ResultGrid DataTable > .datatable--hover {
    background: #1a1d22;
}

/* Highlight new rows briefly */
@keyframes new-row-flash {
    0% {
        background: #2a4a4a;
    }
    100% {
        background: transparent;
    }
}

